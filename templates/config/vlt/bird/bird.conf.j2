{# This host's own EUI-64 link-local, derived from its Vultr /64 address.
   Used as the next-hop for the announced research prefixes: it is deliberately
   NOT the upstream gateway, so inbound traffic for those prefixes is not
   forwarded back out to Vultr (which would loop, since we originate them). #}
{% set link_local = 'fe80::' + ':'.join(v6_main_ip.split(':')[-4:]) %}
{# Vultr's IPv6 gateway link-local. The host NIC is MAC 56:00:xx:xx:xx:xx and the
   gateway is fe:00:<same tail>, so after the EUI-64 U/L bit flip only the first
   group differs: 5400 -> fc00. Verified on vltewr01/vltcdg01/vltsgp01.
   This MUST be the gateway, not this host: pointing the Vultr BGP peer route at
   our own link-local makes 2001:19f0:ffff::1 unreachable and the Vultrv6 session
   never leaves Connect ("Socket: No route to host"), so nothing is announced. #}
{% set vultr_gateway_link_local = 'fe80::fc00:' + ':'.join(v6_main_ip.split(':')[-3:]) %}
router id {{ main_ip }};

log syslog all;

protocol device { scan time 5; }
protocol direct { ipv4; }
protocol direct { ipv6; }

protocol kernel {
  learn;
  metric 0;
  ipv6 {
    import all;
    export none;
  };
}

# Static
protocol static AnnResAnycast {
    ipv6;
    route 2a0e:97c0:8a0::/48 via {{ link_local }} dev "enp1s0";
}
protocol static AnnResUnicast {
    ipv6;
    route {{ uniprobe0 }} via {{ link_local }} dev "enp1s0";
}

protocol static VultrUplinkPeer {
    ipv6;
    route 2001:19f0:ffff::1/128 via {{ vultr_gateway_link_local }} dev "enp1s0";
}

# RPKI
roa6 table r6;
protocol rpki {
  roa6 { table r6; };

  remote "rtr.rpki.cloudflare.com" port 8282;

  retry keep 90;
  refresh keep 900;
  expire keep 172800;
}

# BMP
# NOTE: `protocol bmp` requires the source-built BIRD from
# playbooks/install-bird.yml (/usr/local/sbin/bird, configured
# --with-protocols='bmp,bgp,rpki,static'). The Debian `bird2` package
# (/usr/sbin/bird) is built WITHOUT bmp and rejects this block with
# "syntax error, unexpected CF_SYM_UNDEFINED" at config parse time.
# If a distro bird package gets installed on a host it also hijacks
# /lib/systemd/system/bird.service and the control socket path, which breaks
# both this config and bird_exporter. Keep the repo's bird.service (which
# points at /usr/local/sbin/bird) authoritative.
protocol bmp {
    station address ip 2a06:de00:50:cafe:100::c port 4000;
    monitoring rib in pre_policy;
    monitoring rib in post_policy;
}

# Import filters
function is_v6_rpki_invalid () -> bool {
  return roa_check(r6, net, bgp_path.last_nonaggregated) = ROA_INVALID;
}

filter ImportFilter {
    if is_v6_rpki_invalid() then reject;
    accept;
}

# Export filters
# 2a0e:97c0:8a0::/48 - NXTHDR-RESEARCH Anycast
# {{ uniprobe0 }} - NXTHDR-RESEARCH {{ inventory_hostname | upper }}
filter ExportFilter {
    if (net ~ [ 2a0e:97c0:8a0::/44+ ]) then {
        bgp_path.delete([64512..65534, 4200000000..4294967294]);
        accept;
    } else reject;
}

# BGP upstreams
## Vultr Uplink
protocol bgp VultrUplink  {
    local {{ v6_main_ip }} as 215011;
    neighbor 2001:19f0:ffff::1 as 64515;
    multihop 2;
    graceful restart on;
    password "{{ bird_vultr_peering_password }}";
    ipv6 {
        import keep filtered;
        import filter ImportFilter;
        export filter ExportFilter;
    };
}
